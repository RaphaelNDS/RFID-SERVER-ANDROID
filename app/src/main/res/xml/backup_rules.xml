<?xml version="1.0" encoding="utf-8"?>
<!--
   Regras de backup para Android 8 a 11 (API 26 a 30).
   rfid_prefs.xml (AppConfig) guarda o IP do servidor e a CHAVE DO COLETOR: fica fora do backup.
   rfid-local.db (BancoLocal) é a fila de leituras deste coletor: também fica fora.
   Para Android 12 ou superior, as mesmas regras estão em data_extraction_rules.xml.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="rfid_prefs.xml" />
    <exclude domain="database" path="rfid-local.db" />
</full-backup-content>
