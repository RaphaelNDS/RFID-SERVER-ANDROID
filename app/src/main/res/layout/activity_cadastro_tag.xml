<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Seta de voltar: passa pelo "Descartar o cadastro?" quando há alteração não salva -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/barraCadastro"
        style="@style/Widget.RFID.Barra"
        app:title="@string/cadastro_titulo"
        app:navigationIcon="@drawable/ic_voltar"
        app:navigationIconTint="@color/white"
        app:navigationContentDescription="@string/cadastro_voltar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <!-- O formulário rola; o Salvar fica na barra fixa do rodapé (sobe junto com o teclado: adjustResize) -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:text="@string/cadastro_etiqueta"
                        android:textAppearance="@style/Texto.RFID.Secao"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:id="@+id/txtEpc"
                        android:typeface="monospace"
                        android:textColor="@color/primaria"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:layout_marginTop="4dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>

                    <!-- Grava na etiqueta o código da empresa a partir do patrimônio (CodigoEtiqueta). Some quando a
                         etiqueta já tem o código da empresa -->
                    <Button
                        android:id="@+id/btnGravarCodigo"
                        style="@style/Widget.RFID.Botao.Contorno"
                        android:text="@string/cadastro_gravar_codigo"
                        android:visibility="gone"
                        android:layout_marginTop="8dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:id="@+id/txtAviso"
                        style="@style/Texto.RFID.Aviso"
                        android:visibility="gone"
                        android:layout_marginTop="12dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:text="@string/cadastro_identificacao"
                        android:textAppearance="@style/Texto.RFID.Secao"
                        android:layout_marginTop="20dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <com.google.android.material.textfield.TextInputLayout
                        android:hint="@string/cadastro_codigo_interno"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtCodigoInterno"
                            android:inputType="text|textNoSuggestions|textCapCharacters"
                            android:imeOptions="actionNext"
                            android:importantForAutofill="no"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:hint="@string/comum_patrimonio"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtPatrimonio"
                            android:inputType="text|textNoSuggestions|textCapCharacters"
                            android:imeOptions="actionNext"
                            android:importantForAutofill="no"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:hint="@string/cadastro_numero_serie"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtNumeroSerie"
                            android:inputType="text|textNoSuggestions|textCapCharacters"
                            android:imeOptions="actionDone"
                            android:importantForAutofill="no"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:text="@string/cadastro_equipamento"
                        android:textAppearance="@style/Texto.RFID.Secao"
                        android:layout_marginTop="20dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:text="@string/cadastro_tipo_equipamento"
                        android:textAppearance="@style/Texto.RFID.Secundario"
                        android:layout_marginTop="12dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <Spinner
                        android:id="@+id/spnTipo"
                        android:background="@drawable/campo_contorno"
                        android:minHeight="52dp"
                        android:layout_marginTop="4dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:text="@string/cadastro_marca"
                        android:textAppearance="@style/Texto.RFID.Secundario"
                        android:layout_marginTop="12dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <Spinner
                        android:id="@+id/spnMarca"
                        android:background="@drawable/campo_contorno"
                        android:minHeight="52dp"
                        android:layout_marginTop="4dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:text="@string/cadastro_modelo"
                        android:textAppearance="@style/Texto.RFID.Secundario"
                        android:layout_marginTop="12dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <Spinner
                        android:id="@+id/spnModelo"
                        android:background="@drawable/campo_contorno"
                        android:minHeight="52dp"
                        android:layout_marginTop="4dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>

    <!-- Barra fixa do rodapé: o Salvar sempre à vista, sem rolar o formulário -->
    <View
        android:background="@color/borda"
        android:layout_width="match_parent"
        android:layout_height="1dp"/>

    <FrameLayout
        android:background="@color/superficie"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <Button
            android:id="@+id/btnSalvar"
            android:text="@string/cadastro_salvar"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:layout_width="match_parent"
            android:layout_height="56dp"/>
    </FrameLayout>
</LinearLayout>
