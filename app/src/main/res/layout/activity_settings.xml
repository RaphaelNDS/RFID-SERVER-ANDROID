<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/barraConfiguracoes"
        style="@style/Widget.RFID.Barra"
        app:title="@string/config_barra_titulo"
        app:navigationIcon="@drawable/ic_voltar"
        app:navigationIconTint="@color/white"
        app:navigationContentDescription="@string/config_voltar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Servidor -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:text="@string/config_servidor"
                        android:textAppearance="@style/Texto.RFID.Secao"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:id="@+id/txtStatusServidor"
                        android:text="@string/config_servidor_verificando"
                        android:textStyle="bold"
                        android:layout_marginTop="8dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>

                    <com.google.android.material.textfield.TextInputLayout
                        android:hint="@string/config_ip_hint"
                        app:helperText="Ex.: 192.168.0.10 ou 192.168.0.10:8443"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtIp"
                            android:inputType="textUri|textNoSuggestions"
                            android:imeOptions="actionNext"
                            android:importantForAutofill="no"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layoutChave"
                        android:hint="@string/config_chave_hint"
                        app:helperText="Fornecida pelo administrador do servidor"
                        app:endIconMode="password_toggle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtChave"
                            android:inputType="textPassword|textNoSuggestions"
                            android:importantForAutofill="no"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <Button
                        android:id="@+id/btnSalvar"
                        android:text="@string/config_salvar"
                        android:layout_marginTop="16dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>

                    <Button
                        android:id="@+id/btnTestarServidor"
                        style="@style/Widget.RFID.Botao.Contorno"
                        android:text="@string/config_testar_conexao"
                        android:layout_marginTop="8dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Leitura -->
            <com.google.android.material.card.MaterialCardView
                android:layout_marginTop="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:text="@string/config_leitura"
                        android:textAppearance="@style/Texto.RFID.Secao"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <!-- Vale na hora (sem precisar do botão Salvar), para quem está no campo -->
                    <CheckBox
                        android:id="@+id/chkAvisoLeitura"
                        android:text="@string/config_aviso_leitura"
                        android:layout_marginTop="4dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>

                    <!-- Também vale na hora: o leitor recebe a potência nova sem reconectar -->
                    <TextView
                        android:text="@string/config_potencia"
                        android:textAppearance="@style/Texto.RFID.Secundario"
                        android:layout_marginTop="12dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <!-- Mesmo contorno das listas do Cadastro -->
                    <Spinner
                        android:id="@+id/spnPotencia"
                        android:background="@drawable/campo_contorno"
                        android:minHeight="52dp"
                        android:layout_marginTop="4dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:text="@string/config_potencia_explicacao"
                        android:textAppearance="@style/Texto.RFID.Secundario"
                        android:layout_marginTop="8dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>

                    <!-- Filtros do gatilho (FiltroLeitura): valem na hora, como a potência; o Localizar não usa -->
                    <TextView
                        android:text="@string/config_alcance"
                        android:textAppearance="@style/Texto.RFID.Secundario"
                        android:layout_marginTop="12dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <Spinner
                        android:id="@+id/spnAlcance"
                        android:background="@drawable/campo_contorno"
                        android:minHeight="52dp"
                        android:layout_marginTop="4dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>

                    <CheckBox
                        android:id="@+id/chkSoEmpresa"
                        android:text="@string/config_so_empresa"
                        android:layout_marginTop="8dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:text="@string/config_filtros_explicacao"
                        android:textAppearance="@style/Texto.RFID.Secundario"
                        android:layout_marginTop="4dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Certificado -->
            <com.google.android.material.card.MaterialCardView
                android:layout_marginTop="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:text="@string/config_certificado"
                        android:textAppearance="@style/Texto.RFID.Secao"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <!-- Impressão digital do certificado HTTPS confirmado (conferir com a tela Status do servidor) -->
                    <TextView
                        android:id="@+id/txtCertificado"
                        android:typeface="monospace"
                        android:textSize="12sp"
                        android:textColor="@color/texto"
                        android:layout_marginTop="8dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Aplicativo -->
            <com.google.android.material.card.MaterialCardView
                android:layout_marginTop="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:text="@string/config_aplicativo"
                        android:textAppearance="@style/Texto.RFID.Secao"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:id="@+id/txtVersao"
                        android:textAppearance="@style/Texto.RFID.Secundario"
                        android:layout_marginTop="8dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>

                    <!-- Consulta a versão publicada no servidor (a tela de login também consulta sozinha, a cada 30 min) -->
                    <Button
                        android:id="@+id/btnAtualizacao"
                        style="@style/Widget.RFID.Botao.Contorno"
                        android:text="@string/config_procurar_atualizacao"
                        android:layout_marginTop="8dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
