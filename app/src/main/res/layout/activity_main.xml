<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorPrimary"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"/>

    <include layout="@layout/include_estado_leitor"/>

    <!-- Operador e até quando vale a sessão (na barra de cima não cabe, com os ícones do menu) -->
    <TextView
        android:id="@+id/txtSessao"
        android:textSize="13sp"
        android:textColor="#555555"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="4dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <!-- Aparece só quando há leituras guardadas no aparelho aguardando envio -->
    <TextView
        android:id="@+id/txtSincronizacao"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFF3E0"
        android:padding="8dp"
        android:textColor="#E65100"
        android:textStyle="bold"
        android:visibility="gone"/>

    <!-- Contadores da leitura atual (zeram no botão "Nova leitura") -->
    <TextView
        android:id="@+id/txtContadores"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:textStyle="bold"/>

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/pager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

</LinearLayout>
