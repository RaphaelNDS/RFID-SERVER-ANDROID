<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:orientation="vertical"
        android:padding="24dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:text="@string/app_name"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:text="Entre com seu usuário do Sistema RFID"
            android:layout_marginTop="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <EditText
            android:id="@+id/edtEmail"
            android:hint="Email"
            android:inputType="textEmailAddress"
            android:autofillHints="emailAddress"
            android:layout_marginTop="24dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <EditText
            android:id="@+id/edtSenha"
            android:hint="Senha"
            android:inputType="textPassword"
            android:autofillHints="password"
            android:imeOptions="actionDone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <Button
            android:id="@+id/btnEntrar"
            android:text="Entrar"
            android:layout_marginTop="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/txtStatus"
            android:visibility="gone"
            android:textColor="#C62828"
            android:layout_marginTop="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <!-- O pedido vai para o administrador, que gera uma senha temporária (trocada na web) -->
        <Button
            android:id="@+id/btnEsqueciSenha"
            style="@style/Widget.Material3.Button.TextButton"
            android:text="Esqueceu a senha?"
            android:layout_marginTop="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <!-- O IP e a chave do coletor precisam estar configurados antes do primeiro login -->
        <Button
            android:id="@+id/btnConfiguracoes"
            style="@style/Widget.Material3.Button.TextButton"
            android:text="Configurações do coletor"
            android:layout_marginTop="24dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <!-- Versão instalada (para o suporte saber se o coletor está atualizado) -->
        <TextView
            android:id="@+id/txtVersao"
            android:textSize="12sp"
            android:textColor="#888888"
            android:layout_marginTop="16dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
</ScrollView>
