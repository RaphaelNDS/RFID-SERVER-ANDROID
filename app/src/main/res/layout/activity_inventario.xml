<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <!-- Seta de voltar; com inventário aberto, o local vai no subtítulo e "Cancelar inventário" fica no menu
         (menu_inventario), longe do dedo: assim o cabeçalho sobra para a lista -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/barraInventario"
        style="@style/Widget.RFID.Barra"
        app:title="@string/inventario_barra_titulo"
        app:navigationIcon="@drawable/ic_voltar"
        app:navigationContentDescription="@string/tela_voltar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <!-- Inventário ou etiquetas que o coletor desistiu de enviar (some no "Ciente") -->
    <include layout="@layout/include_aviso_recusa"/>

    <!-- Antes de começar: escolher o local -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/painelInicio"
        android:layout_margin="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:text="@string/inventario_local_titulo"
                android:textAppearance="@style/Texto.RFID.Secao"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <!-- Estilo de lista: dá ao campo com sugestões o mesmo espaçamento dos outros. A seta no fim do campo abre a
                 lista de locais inteira (antes só aparecia digitando uma letra, e parecia que o local não existia) -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/campoLocal"
                style="@style/Widget.RFID.Campo.Lista"
                android:hint="@string/inventario_local_hint"
                app:endIconMode="dropdown_menu"
                app:helperText="@string/inventario_local_exemplo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- "Ir" do teclado inicia o inventário (o teclado e as sugestões cobriam o botão). Sem a barra de
                     sugestões do teclado: as sugestões que valem são as da lista de locais. Sem maxLength: o limite
                     (LocalInventario.MAXIMO) é conferido no "Iniciar", que avisa no campo em vez de cortar calado -->
                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/edtLocal"
                    android:inputType="text|textNoSuggestions|textCapSentences"
                    android:imeOptions="actionGo"
                    android:maxLines="1"
                    android:completionThreshold="1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </com.google.android.material.textfield.TextInputLayout>

            <Button
                android:id="@+id/btnIniciar"
                android:text="@string/inventario_iniciar"
                android:layout_marginTop="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <!-- Resumos dos inventários já finalizados neste coletor (HistoricoInventarios) -->
            <Button
                android:id="@+id/btnAnteriores"
                style="@style/Widget.RFID.Botao.Texto"
                android:text="@string/inventario_anteriores"
                android:minHeight="48dp"
                android:layout_marginTop="4dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Inventário em andamento: cabeçalho enxuto (leitor, resumo, referência), abas, filtro, a lista ocupa o resto
         e "Finalizar" fica fixo no rodapé. A instrução do gatilho some depois da primeira leitura (RegrasTelaInventario) -->
    <LinearLayout
        android:id="@+id/painelAndamento"
        android:orientation="vertical"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <include
            layout="@layout/include_estado_leitor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <!-- Some enquanto o teclado está aberto (InventarioActivity.abrirEspacoComTeclado), junto com "Finalizar" -->
        <LinearLayout
            android:id="@+id/cabecalhoAndamento"
            android:orientation="vertical"
            android:background="@color/superficie"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="6dp"
            android:paddingBottom="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Contagens (lidas, esperadas, faltam, fora da lista): no máximo 2 linhas -->
            <TextView
                android:id="@+id/txtResumo"
                android:textColor="@color/texto"
                android:textSize="15sp"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <!-- Com o que está comparando (ou por que não compara): uma linha só -->
            <TextView
                android:id="@+id/txtReferencia"
                android:textColor="@color/texto_secundario"
                android:textSize="13sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginTop="2dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <!-- Inventário recusado pelo servidor: no máximo 2 linhas (a faixa vermelha do topo também avisa) -->
            <TextView
                android:id="@+id/txtRecusado"
                android:textColor="@color/erro"
                android:textSize="14sp"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end"
                android:visibility="gone"
                android:layout_marginTop="4dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <!-- Etiquetas aguardando envio: dá para pedir o envio na hora -->
            <LinearLayout
                android:id="@+id/linhaEnvio"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/txtAguardando"
                    android:textColor="@color/texto"
                    android:textSize="14sp"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"/>

                <Button
                    android:id="@+id/btnEnviarAgora"
                    style="@style/Widget.RFID.Botao.Texto"
                    android:text="@string/inventario_enviar_agora"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

            <!-- A sincronização só volta quando alguém mexe nas Configurações (chave, endereço, certificado) -->
            <TextView
                android:id="@+id/txtChameResponsavel"
                android:text="@string/inventario_chame_responsavel"
                android:textColor="@color/erro"
                android:textStyle="bold"
                android:textSize="14sp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <!-- Só até a primeira leitura: depois disso o operador já sabe, e a linha vira espaço para a lista -->
            <TextView
                android:id="@+id/txtStatus"
                android:text="@string/inventario_instrucao"
                android:textAppearance="@style/Texto.RFID.Secundario"
                android:layout_marginTop="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <View
            android:background="@color/borda"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabsInventario"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <!-- Só com lista grande (FiltroInventario): filtra em memória a aba aberta. Patrimônio e EPC em maiúsculas,
             sem sugestões do teclado; "Buscar" do teclado só fecha o teclado (o filtro já vale enquanto digita) -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/campoFiltro"
            android:hint="@string/inventario_filtro_hint"
            android:visibility="gone"
            app:endIconMode="clear_text"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginTop="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edtFiltro"
                android:inputType="text|textNoSuggestions|textCapCharacters"
                android:imeOptions="actionSearch"
                android:maxLines="1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </com.google.android.material.textfield.TextInputLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerItens"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:clipToPadding="false"
            android:layout_weight="1"
            android:layout_width="match_parent"
            android:layout_height="0dp"/>

        <!-- Barra fixa do rodapé, fora da lista que rola: sempre à mão, na largura toda -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFinalizar"
            android:text="@string/inventario_finalizar"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:cornerRadius="0dp"
            android:minHeight="56dp"
            android:layout_width="match_parent"
            android:layout_height="56dp"/>
    </LinearLayout>
</LinearLayout>
