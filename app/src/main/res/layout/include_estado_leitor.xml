<?xml version="1.0" encoding="utf-8"?>
<!-- Situação do leitor RFID (IndicadorLeitor): conectado, conectando ou desconectado com botão "Reconectar" -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/painelEstadoLeitor"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:minHeight="36dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <TextView
        android:id="@+id/txtEstadoLeitor"
        android:textStyle="bold"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"/>

    <Button
        android:id="@+id/btnReconectarLeitor"
        style="?android:attr/borderlessButtonStyle"
        android:text="Reconectar"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
</LinearLayout>
