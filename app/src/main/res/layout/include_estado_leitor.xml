<?xml version="1.0" encoding="utf-8"?>
<!-- Situação do leitor RFID (IndicadorLeitor): conectado, conectando ou desconectado com botão "Reconectar" -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/painelEstadoLeitor"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="16dp"
    android:paddingEnd="8dp"
    android:minHeight="40dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <!-- Bolinha na cor da situação (IndicadorLeitor pinta junto com o texto) -->
    <View
        android:id="@+id/marcaEstadoLeitor"
        android:background="@drawable/marca_estado"
        android:layout_marginEnd="10dp"
        android:layout_width="10dp"
        android:layout_height="10dp"/>

    <TextView
        android:id="@+id/txtEstadoLeitor"
        android:textStyle="bold"
        android:textSize="14sp"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"/>

    <Button
        android:id="@+id/btnReconectarLeitor"
        style="@style/Widget.RFID.Botao.Texto"
        android:text="Reconectar"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
</LinearLayout>
