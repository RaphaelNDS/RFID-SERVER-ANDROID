<?xml version="1.0" encoding="utf-8"?>
<!-- Etiqueta cadastrada lida (TagAdapter): patrimônio em destaque, "Tipo · Marca · Modelo" e, menor, código e série.
     Três linhas curtas (~80dp) para caber mais itens na tela de 4" -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_marginTop="3dp"
    android:layout_marginBottom="3dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- "Patrimônio 12345" (marinho, negrito) ou "Sem patrimônio" (itálico, cinza): o TagAdapter pinta -->
        <TextView
            android:id="@+id/txtPatrimonio"
            android:textColor="@color/primaria"
            android:textSize="18sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <!-- Tipo · Marca · Modelo -->
        <TextView
            android:id="@+id/txtDescricao"
            android:textColor="@color/texto"
            android:textSize="15sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="2dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <!-- Cód. X · Série Y -->
        <TextView
            android:id="@+id/txtCodigos"
            android:textColor="@color/texto_secundario"
            android:textSize="14sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <!-- Bem baixado ou extraviado no cadastro (servidor 1.6.2+): não deveria estar circulando -->
        <TextView
            android:id="@+id/txtAlerta"
            android:textColor="@color/erro"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end"
            android:visibility="gone"
            android:layout_marginTop="2dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
