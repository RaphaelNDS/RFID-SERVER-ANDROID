<?xml version="1.0" encoding="utf-8"?>
<!-- Etiqueta lida no inventário (LidaInventarioAdapter). Fora da lista: fundo de atenção e o aviso abaixo -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="4dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:orientation="vertical"
        android:padding="12dp"
        android:background="?android:attr/selectableItemBackground"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/txtLida"
            android:typeface="monospace"
            android:textColor="@color/texto"
            android:textSize="14sp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/txtForaDaLista"
            android:text="@string/inventario_lida_fora_da_lista"
            android:textColor="@color/atencao"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginTop="2dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <!-- Transferência para este local pedida no inventário: aguardando envio, feita (com a guia) ou recusada -->
        <TextView
            android:id="@+id/txtTransferencia"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginTop="2dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
