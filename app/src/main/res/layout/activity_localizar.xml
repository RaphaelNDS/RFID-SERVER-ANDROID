<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/barraLocalizar"
        style="@style/Widget.RFID.Barra"
        app:title="@string/localizar_barra_titulo"
        app:navigationIcon="@drawable/ic_voltar"
        app:navigationContentDescription="@string/tela_voltar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <include
        layout="@layout/include_estado_leitor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <!-- Busca: recolhida enquanto localiza (sobra a tela para a proximidade); "Alterar" traz de volta -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cartaoBusca"
        android:layout_margin="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:text="@string/localizar_titulo"
                android:textAppearance="@style/Texto.RFID.Secao"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <com.google.android.material.textfield.TextInputLayout
                android:hint="@string/localizar_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- Patrimônio em MAIÚSCULAS, como o cadastro grava (a busca também converte: RegrasLocalizar) -->
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtPatrimonio"
                    android:inputType="text|textNoSuggestions|textCapCharacters"
                    android:imeOptions="actionSearch"
                    android:maxLines="1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </com.google.android.material.textfield.TextInputLayout>

            <Button
                android:id="@+id/btnBuscar"
                android:text="@string/localizar_buscar"
                android:layout_marginTop="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- No lugar do cartão de busca, enquanto localiza: o que está sendo procurado e "Alterar" -->
    <LinearLayout
        android:id="@+id/linhaProcurando"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/superficie"
        android:paddingStart="16dp"
        android:paddingEnd="8dp"
        android:minHeight="48dp"
        android:visibility="gone"
        android:layout_marginBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- EPC é comprido: corta no meio para mostrar o começo e o fim -->
        <TextView
            android:id="@+id/txtProcurando"
            android:textColor="@color/primaria"
            android:textSize="16sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="middle"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"/>

        <Button
            android:id="@+id/btnAlterarBusca"
            style="@style/Widget.RFID.Botao.Texto"
            android:text="@string/localizar_alterar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>

    <!-- Proximidade: ocupa o resto da tela, com texto e barra grandes para ler de longe andando -->
    <com.google.android.material.card.MaterialCardView
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:layout_weight="1"
        android:layout_width="match_parent"
        android:layout_height="0dp">

        <LinearLayout
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <TextView
                android:text="@string/localizar_proximidade"
                android:textAppearance="@style/Texto.RFID.Secao"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <!-- Ocupa o que sobra, até 30sp e encolhendo (autoSize) para caber: em 320x533dp, com o cartão de
                 busca aberto, o texto em 30sp fixo espremia e cortava a barra de baixo. A barra fica sempre inteira -->
            <TextView
                android:id="@+id/txtStatus"
                android:text="@string/localizar_aguardando"
                android:textColor="@color/texto"
                android:textStyle="bold"
                android:gravity="center"
                android:accessibilityLiveRegion="polite"
                app:autoSizeTextType="uniform"
                app:autoSizeMinTextSize="14sp"
                app:autoSizeMaxTextSize="30sp"
                android:layout_weight="1"
                android:layout_width="match_parent"
                android:layout_height="0dp"/>

            <!-- Barra de distância: quanto mais cheia, mais perto da etiqueta. A cor muda por faixa
                 (Proximidade.faixa): cinza longe, âmbar aproximando, verde muito perto -->
            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progressDistancia"
                android:max="100"
                android:progress="0"
                app:trackThickness="36dp"
                app:trackCornerRadius="8dp"
                app:trackStopIndicatorSize="0dp"
                app:indicatorColor="@color/texto_terciario"
                app:trackColor="@color/borda"
                android:layout_marginTop="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
