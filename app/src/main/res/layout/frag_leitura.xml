<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Sem título de seção: a aba já diz "Leitura (N)" e a tela de 4" precisa da altura para a lista -->

    <!-- Lista vazia: diz o que fazer (some com a primeira etiqueta lida) -->
    <TextView
        android:id="@+id/txtVazioLeitura"
        android:text="@string/leitura_vazia"
        android:textAppearance="@style/Texto.RFID.Secundario"
        android:gravity="center"
        android:padding="24dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="4dp"
        android:paddingBottom="8dp"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</LinearLayout>
