<?xml version="1.0" encoding="utf-8"?>
<!-- Contorno das listas (Spinner) igual ao dos campos de texto, com a seta à direita -->
<!-- paddingMode stack: a seta não é empurrada para dentro pelo padding reservado para ela -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android" android:paddingMode="stack">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/superficie"/>
            <stroke android:width="1dp" android:color="@color/texto_terciario"/>
            <corners android:radius="6dp"/>
            <padding android:left="4dp" android:right="40dp"/>
        </shape>
    </item>
    <item
        android:drawable="@drawable/seta_lista"
        android:gravity="right|center_vertical"
        android:right="12dp"
        android:width="24dp"
        android:height="24dp"/>
</layer-list>
